# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
# Replace [YOUR-PASSWORD]. Keep it server-side only (never prefix with NEXT_PUBLIC_).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Master key for the hidden platform console (use 32+ random characters).
SUPER_ADMIN_KEY=change-me-to-a-long-random-string
